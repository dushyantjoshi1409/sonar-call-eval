# Optional backward-compatible Gemini fallback. Browser-entered keys are never written here.
# Use only a project whose free-tier eligibility you verified in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set true only after checking the key's project in Google AI Studio.
GEMINI_FREE_TIER_CONFIRMED=false
VOICE_EVAL_FREE_ONLY=true
VOICE_EVAL_DATA_DIR=./data
VOICE_EVAL_HOST=127.0.0.1
VOICE_EVAL_PORT=8000
